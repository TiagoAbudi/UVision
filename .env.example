# Exemplo publico. Copie para ../.env conforme docs/installation.md.
# 192.0.2.0/24 e reservada para documentacao: substitua os hosts.
# Nunca publique o .env real nem coloque credenciais dentro das URLs.

# Desktop multicamera: obrigatorios.
DVR_HOST=192.0.2.10
DVR_USER=operador
DVR_PASSWORD=
DVR_CHANNEL_COUNT=8

# Vazio desativa o nono canal; usa as mesmas credenciais do DVR.
EXTRA_CAMERA_HOST=
EXTRA_CAMERA_NAME=Camera adicional

# Pose para quedas + yolo26s.pt na mesma pasta (pesos nao versionados).
YOLO_MODEL=yolo26s-pose.pt
YOLO_DEVICE=auto
YOLO_IMAGE_SIZE=640
CONFIDENCE_THRESHOLD=0.50
ANIMAL_FILTER_ENABLED=true
DVR_DETECTION_INTERVAL=0.30

# Monitores independentes em todos os canais disponiveis.
FALL_MONITOR_CHANNEL=4
FALL_MONITOR_CHANNELS=all
FALL_SHADOW_MODE=true
FALL_CAMERA_ROTATION=0
FALL_GROUND_CONFIRM_SECONDS=3
# Vazio evita carregar calibracao privada de outra instalacao.
FALL_GEOMETRY_PROFILE=
# Zonas salvas pela UI tem precedencia sobre ajustes opcionais por canal.
# FALL_CAMERA_ROTATION_CH01=0
# FALL_GEOMETRY_PROFILE_CH01=calibration/ch01-geometry.json

# Limite de arquivos nao protegidos por camera.
FALL_VIDEO_ENABLED=true
FALL_VIDEO_FPS=8
FALL_VIDEO_PRE_SECONDS=8
FALL_VIDEO_POST_SECONDS=8
FALL_VIDEO_MAX_FILES=30

# Alertas desativados inicialmente. Configure na pagina Alertas.
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_IDS=
TELEGRAM_CHANNELS=1,2,3,4,5,6,7,8,9
TELEGRAM_ALLOW_CALIBRATION=false
TELEGRAM_REMINDER_SECONDS=90
TELEGRAM_MAX_REMINDERS=3

# Modos legados: nao necessarios para o desktop 3.0.
# DVR_MOSAIC_FPS=6
# DVR_WEB_HOST=127.0.0.1
# DVR_WEB_PORT=8765
# CAMERA_URL=rtsp://192.0.2.11:554/cam/realmonitor?channel=1&subtype=0
# CAMERA_USER=operador
# CAMERA_PASSWORD=
# PRESENCE_CONFIRM_FRAMES=3
# ABSENCE_CONFIRM_FRAMES=10
# DETECTION_COOLDOWN=30
# DISPLAY_ENABLED=true
# SNAPSHOT_ON_EVENT=false
# LIGHT_AUTOMATION_ENABLED=false
# LIGHT_COMMAND_TIMEOUT=15
